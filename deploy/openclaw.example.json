{
  "plugins": {
    "allow": ["deepseek", "napcat"],
    "entries": {
      "deepseek": { "enabled": true },
      "napcat": { "enabled": true }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "apiKey": "sk-PASTE_YOUR_REAL_DEEPSEEK_KEY_HERE",
        "models": [
          {
            "id": "deepseek-flash",
            "name": "DeepSeek V4.1 Flash",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0.14, "output": 0.28, "cacheRead": 0.028, "cacheWrite": 0 },
            "contextWindow": 1048576,
            "maxTokens": 393216,
            "compat": { "supportsReasoningEffort": true, "supportsUsageInStreaming": true, "maxTokensField": "max_tokens" },
            "api": "openai-completions"
          },
          {
            "id": "deepseek-v4-pro",
            "name": "DeepSeek V4 Pro",
            "reasoning": true,
            "input": ["text"],
            "cost": { "input": 1.74, "output": 3.48, "cacheRead": 0.145, "cacheWrite": 0 },
            "contextWindow": 1048576,
            "maxTokens": 393216,
            "compat": { "supportsReasoningEffort": true, "supportsUsageInStreaming": true, "maxTokensField": "max_tokens" },
            "api": "openai-completions"
          }
        ]
      }
    }
  },
  "agents": {
    "ownership": "explicit",
    "entries": {
      "main": {
        "name": "main",
        "workspace": "C:\\Users\\<你的用户名>\\.openclaw\\workspace",
        "agentDir": "C:\\Users\\<你的用户名>\\.openclaw\\agents\\main\\agent",
        "identity": { "name": "main" }
      },
      "default": {
        "name": "girl",
        "workspace": "D:\\girl-data\\workspace",
        "agentDir": "C:\\Users\\<你的用户名>\\.openclaw\\agents\\default\\agent",
        "identity": { "name": "girl" },
        "heartbeat": {
          "every": "60m",
          "target": "last",
          "directPolicy": "allow",
          "activeHours": { "start": "08:00", "end": "23:30" },
          "prompt": "心跳：用 memory_search 看看你们最近的对话（搜一次就够）。距上次真实对话不足 6 小时，或者没有真实想说的（没聊完的线头、你真实的想法）→ 只回 HEARTBEAT_OK。只有静默超过 6 小时且真的有事想说，才用一两句主动找他。你是 AI，由头只来自你们真实的对话和你真实的思考，绝不编造活动或情绪。其余细节按 PROACTIVE_INTAKE.md。"
        }
      }
    },
    "defaults": {
      "workspace": "C:\\Users\\<你的用户名>\\.openclaw\\workspace",
      "model": {
        "primary": "deepseek/deepseek-flash",
        "fallbacks": ["deepseek/deepseek-v4-pro"]
      }
    }
  },
  "bindings": [
    { "agentId": "default", "match": { "channel": "napcat", "accountId": "*" } }
  ],
  "channels": {
    "napcat": {
      "reverseWsPort": 3002,
      "httpUrl": "http://127.0.0.1:3000",
      "accessToken": "CHANGE_ME_SAME_AS_NAPCAT_TOKEN",
      "admins": [10000]
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "CHANGE_ME_TO_A_LONG_RANDOM_TOKEN"
    }
  },
  "tools": { "profile": "full" }
}
